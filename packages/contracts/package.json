{
  "name": "@agent-market/contracts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "check": "pnpm typecheck",
    "test": "hardhat test",
    "typecheck": "hardhat compile && tsc -p tsconfig.json",
    "deploy:sepolia": "hardhat run scripts/deploy-sepolia.ts --network sepolia",
