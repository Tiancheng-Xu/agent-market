{
  "name": "agent-market-web",
  "main": "dist/_worker.js",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "agent-market.baby2b.online",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist-client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
