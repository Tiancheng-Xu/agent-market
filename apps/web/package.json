    "react-router-dom": "7.9.6",
    "tailwindcss": "4.1.17"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "7.0.2",
    "vite": "7.3.1",
    "vitest": "4.1.11"
  }
