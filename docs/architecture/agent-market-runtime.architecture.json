  "cards": [
    {
      "dot": "cyan",
      "title": "主要调用链",
      "items": [
        "浏览器 → Cloudflare Edge → Transaction Engine → Queen/LangGraph。",
        "Queen 经 Agent Gateway 选择本地或 Provider Agent，再由 Judge 与 Final Arbiter 收口。",
        "unsigned intent 经钱包签名写入 Sepolia，并独立回读 receipt 与事件。"
      ]
    },
    {
      "dot": "amber",
      "title": "异步链与数据存储",
      "items": [
        "事件经 API Gateway/Lambda、SNS/SQS/DLQ 进入 ECS Fargate Worker。",
        "PostgreSQL/pgvector 保存任务、回执、匹配、性能与脱敏训练摘要。",
        "IndexedDB 仅存公开 Agent 元数据；Evidence 与业务库不是同一真相源。"
      ]
    },
    {
      "dot": "rose",
      "title": "事实边界",
      "items": [
        "Cloudflare、AWS、本地 Runtime 与 Sepolia 必须分别验证，不能互相替代。",
        "Provider Key、私有 Prompt、权重与本地路径不进入公开 Evidence。",
        "AWS 性能 Runtime 按需创建和清理，不代表持续生产 SLO。"
      ]
    }
  ]
